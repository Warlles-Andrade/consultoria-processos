# Supabase Configuration
# Obtenha essas credenciais em: https://app.supabase.com/project/_/settings/api

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica
VITE_SITE_URL=https://www.workive.com.br/

# Serverless / Vercel API routes
# Use as mesmas credenciais acima sem o prefixo VITE_ para o ambiente do servidor
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-publica

# Service Role Key — usada apenas server-side (Vercel API routes) para criar usuários
# IMPORTANTE: NÃO use prefixo VITE_ — esta chave NÃO deve ser exposta ao browser
# Encontre em: Supabase Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta

# Senha de App do Gmail — usada para enviar emails de boas-vindas e notificações
# Passo a passo:
#   1. Ative a autenticação de 2 fatores na conta Gmail
#   2. Acesse: https://myaccount.google.com/apppasswords
#   3. Crie uma senha de app (ex: "Sistema Processos") e cole abaixo
# Limite: 100 emails/dia no Gmail gratuito
GMAIL_APP_PASSWORD=sua-senha-app-gmail
GMAIL_USER=seu-email@gmail.com

# Instruções:
# 1. Copie este arquivo para .env
# 2. Preencha todos os valores acima
# 3. Nunca faça commit do arquivo .env (ele está no .gitignore)
# 4. Adicione as mesmas variáveis no Vercel:
#    Vercel Dashboard → seu projeto → Settings → Environment Variables
